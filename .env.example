# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=invoice_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/invoice_db

# Gemini AI Extraction
# Leave empty to run in deterministic rule-based Demo Mode without requiring an API key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
DEMO_MODE=false

# Document & Processing Constraints
MAX_UPLOAD_SIZE_MB=15
TOTAL_TOLERANCE=0.05

# Optional Custom Tesseract OCR Path (Windows)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

